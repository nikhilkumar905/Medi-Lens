# ---- Groq LLM (required for AI interpretation, voice commands, speech-to-text) ----
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Natural voice (accept model terms once at console.groq.com); falls back to browser voice
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ---- Database: SQLite by default; PostgreSQL example below ----
# DATABASE_URL=postgresql+psycopg://medlens:medlens@localhost:5432/medlens
DATABASE_URL=
STORAGE_DIR=

# ---- Security (CHANGE THESE) ----
SECRET_KEY=replace-with-a-long-random-string
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=medlens123
TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDACT_PHI_FOR_LLM=true

# ---- Medical knowledge ----
PUBMED_API_KEY=
PUBMED_EMAIL=

# ---- OCR (Tesseract binary path if not on PATH) ----
TESSERACT_CMD=

# ---- Optional local imaging models (never downloaded automatically) ----
MEDGEMMA_MODEL_PATH=
MONAI_MODEL_PATH=

# Extra folders the voice assistant may search for reports (semicolon-separated)
FILE_SEARCH_ROOTS=
